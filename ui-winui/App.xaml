<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MicWright.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Overrides of the system theme: one purple accent, flat borderless cards. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#8B7CF6</Color>
                    <Color x:Key="SystemAccentColorLight1">#9D90F8</Color>
                    <Color x:Key="SystemAccentColorLight2">#8B7CF6</Color>
                    <Color x:Key="SystemAccentColorLight3">#B4A9FA</Color>
                    <Color x:Key="SystemAccentColorDark1">#7464E0</Color>
                    <Color x:Key="SystemAccentColorDark2">#5D4FC4</Color>
                    <Color x:Key="SystemAccentColorDark3">#473BA3</Color>

                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

            <!-- Design tokens. Kept out of the theme dictionaries: the app is always dark. -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#2A2A2C" />
            <SolidColorBrush x:Key="AppCardHoverBrush" Color="#333336" />
            <SolidColorBrush x:Key="AppCardPressedBrush" Color="#242426" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#8B7CF6" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#A3A3A8" />

            <SolidColorBrush x:Key="PillGoodBackground" Color="#123A22" />
            <SolidColorBrush x:Key="PillGoodForeground" Color="#34D27B" />
            <SolidColorBrush x:Key="PillWarnBackground" Color="#3D3212" />
            <SolidColorBrush x:Key="PillWarnForeground" Color="#F5C542" />
            <SolidColorBrush x:Key="PillBadBackground" Color="#40191B" />
            <SolidColorBrush x:Key="PillBadForeground" Color="#F87171" />
            <SolidColorBrush x:Key="PillOffBackground" Color="#3A3A3D" />
            <SolidColorBrush x:Key="PillOffForeground" Color="#C8C8CC" />

            <!-- Spacing used between settings cards. -->
            <x:Double x:Key="SettingsCardSpacing">8</x:Double>

            <!-- Type scale: quiet labels over bold values. -->
            <Style x:Key="BrandTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="80" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CardLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            </Style>
            <Style x:Key="CardValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="TileTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CardLabelStyle}">
                <Setter Property="Margin" Value="1,20,0,8" />
            </Style>
            <Style x:Key="PillTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PillStyle" TargetType="Border">
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AppCardBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <!-- The toolkit cards ignore app-level brush overrides, so set their look directly. -->
            <Style TargetType="tk:SettingsCard">
                <Setter Property="Background" Value="{StaticResource AppCardBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style TargetType="tk:SettingsExpander">
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <!-- Expanders and info bars are translucent: this goes behind them to make them cards. -->
            <Style x:Key="CardBackingStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AppCardBrush}" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <!-- A whole card you can press: same look as CardStyle, plus hover and press. -->
            <Style x:Key="TileButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AppCardBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              AutomationProperties.AccessibilityView="Raw">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{StaticResource AppCardHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{StaticResource AppCardPressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
